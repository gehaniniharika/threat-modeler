{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PHANTOM-B Threat Analysis",
  "type": "object",
  "required": ["application_name", "framework", "verdict", "threats", "summary"],
  "properties": {
    "application_name": {
      "type": "string",
      "description": "Name of the analyzed application"
    },
    "framework": {
      "type": "string",
      "enum": ["PHANTOM-B"],
      "description": "Threat modeling framework used"
    },
    "verdict": {
      "type": "string",
      "enum": ["TRUE_POSITIVE", "FALSE_POSITIVE", "UNCLEAR"],
      "description": "Overall security verdict"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Confidence level of verdict (0-100)"
    },
    "summary": {
      "type": "string",
      "description": "Executive summary of findings"
    },
    "threats": {
      "type": "array",
      "description": "List of identified behavioral threats",
      "items": {
        "type": "object",
        "required": ["id", "title", "severity"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^B[0-9]{3}$",
            "description": "Threat ID (B001, B002, etc.)"
          },
          "title": {
            "type": "string",
            "description": "Threat title"
          },
          "description": {
            "type": "string",
            "description": "Detailed threat description"
          },
          "severity": {
            "type": "string",
            "enum": ["Critical", "High", "Medium", "Low"],
            "description": "Threat severity"
          },
          "normal_behavior": {
            "type": "string",
            "description": "Expected normal behavior pattern"
          },
          "anomaly_pattern": {
            "type": "string",
            "description": "Behavioral anomaly indicating threat"
          },
          "probability": {
            "type": "string",
            "enum": ["Very High", "High", "Medium", "Low", "Very Low"],
            "description": "Probability of threat occurrence"
          },
          "detection_method": {
            "type": "string",
            "description": "How to detect this anomaly"
          },
          "monitoring_approach": {
            "type": "string",
            "description": "Monitoring and alerting approach"
          }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "description": "Monitoring and prevention recommendations",
      "items": {"type": "string"}
    }
  }
}
